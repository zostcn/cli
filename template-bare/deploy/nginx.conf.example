# 路径片段 —— **生产形态**:各前端统一挂主域子路径 zost.cn/<项目名>/。
#
# 生产机(共享 nginx)的机制:zost.cn 主块(人工全权:server 级安全头、TLS)
# 里有块内 include(/srv/zost/*/loc/*.conf)—— CI 只交本片段,
# 落 /srv/zost/<项目名>/loc/<项目名>.conf。片段只准写 location:server_name /
# 证书 / server 级头全部不归 CI 管。
#
# 与测试机形态(deploy/nginx.conf)的差异只有一条:测试机没有主块,CI 交完整
# server 块;生产主块已就位,CI 交片段。片段自身(root + webroot 软链、SPA
# 回退、资源缓存)两处逐字一致 —— 上主站就是把 deploy/nginx.conf 换成本文件、
# workflow 的 conf 落点 conf/ 换成 loc/。
#
# ⚠️ 不用 alias + try_files:try_files 的检查路径是 alias + **完整 $uri**(不剥
#    location 前缀),检查永远落空、全部请求掉进回退。用 root + 布局对齐:
#    webroot/<项目名> → current(CI 软链),URI /<项目名>/x 正好映到 current/x。
# ⚠️ add_header 不继承:location 里只要有一条 add_header,主块同类头全部失效
#    —— /assets/ 带了 Cache-Control,就必须自带全套安全头(与主块同值);
#    其余 location 不带 add_header,继承主块。

# ---- SPA 壳(未命中路径回 index.html,否则深链刷新 404)----
location ^~ /<项目名>/ {
    root /srv/zost/<项目名>/webroot;
    try_files $uri $uri/ /<项目名>/index.html;
}

# ---- 静态资源(带 hash 的可长缓存;index.html 不走这里)----
location ^~ /<项目名>/assets/ {
    root /srv/zost/<项目名>/webroot;
    expires 1y;
    # 本行触发 add_header 继承断链 → 下面必须重复主块的全套安全头
    add_header Cache-Control "public, immutable";
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https://zost.oss-cn-chengdu.aliyuncs.com; frame-src 'self' https://zost.oss-cn-chengdu.aliyuncs.com; connect-src 'self' https://zost.oss-cn-chengdu.aliyuncs.com;" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
